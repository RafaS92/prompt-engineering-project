# Application
APP_ENV=development
APP_PORT=8000

# Required for POST /v1/tickets/analyze and live Promptfoo evaluations.
# Keep the real key only in .env; never commit it.
OPENAI_API_KEY=
OPENAI_MODEL=

# Prompt behavior
TRIAGE_PROMPT_STRATEGY=zero_shot
POLICY_DECISION_SAMPLE_COUNT=1

# Local PostgreSQL. DATABASE_URL is used by non-Compose local runs; Compose constructs
# its internal URL from the POSTGRES_* values below.
DATABASE_URL=postgresql+asyncpg://support_prompt_lab:support_prompt_lab@localhost:5432/support_prompt_lab
POSTGRES_USER=support_prompt_lab
POSTGRES_PASSWORD=support_prompt_lab
POSTGRES_DB=support_prompt_lab
POSTGRES_PORT=5432
